  "narrative": {
    "northStar": "深色科技 Bento",
    "overview": "用户指定的 Apple/Bento 方向以墨蓝背景、半透明圆角表面与安静的细边框呈现。紫色提供柔和的空间氛围，青色帮助识别操作与技术线索；内容保持清晰、克制，让真实作品与学习记录承担说服力。\n\n信息密度通过大小不同的容器组织，文字与原始素材保持可读。桌面倾斜是指针反馈，移动端和减少动态模式保持静态。系统字体避免远程字体加载，使离线阅读的外观稳定。",
    "keyCharacteristics": [
      "墨蓝底色与半透明深色表面。",
      "青色操作提示、紫色氛围与薄边框。",
      "圆角 Bento 容器与直接可读的中文层级。",
      "桌面轻微空间反馈，手机静态阅读。"
    ],
    "rules": [],
    "dos": [
      "Do 保持深色科技 Bento、柔和圆角与安静边界。",
      "Do 用真实原图、简洁文字与可打开的链接表达成果。",
      "Do 为键盘焦点提供可见轮廓，并在触摸与减少动态模式保持静态。",
      "Do 让手机文字和打印内容自然换行。"
    ],
    "donts": [
      "Don't 把长段正文做成渐变、发光字或动态效果。",
      "Don't 为装饰裁切证书文字，或改写原始素材中的事实。",
      "Don't 让倾斜阻碍视频控制、打印或移动端阅读。",
      "Don't 添加无事实来源的能力、排名、规模或模型版本。"
    ]
  }
}
